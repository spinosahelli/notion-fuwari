---
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";

import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getPostTranslationKey,
	getPostUrlBySlug,
	getPostUrlBySlugAndLang,
	isChinesePostLanguage,
	isEnglishPostLanguage,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { gitHubEditConfig, licenseConfig } from "src/config";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig } from "../../config";
import { getCurrentLocale, t } from "../../i18n";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

const locale = getCurrentLocale();

type StaticPathSeo = {
	translationKey: string;
	canonicalPath: string;
	altPathZh: string;
	altPathEn: string;
};

function toAbsoluteUrl(path: string): string {
	return new URL(path, Astro.site ?? Astro.url).href;
}

export async function getStaticPaths() {
	const zhEntries = await getSortedPosts("zh-CN");
	const allEntries = await getSortedPosts();
	const isEnglishEntry = (
		entry: Awaited<ReturnType<typeof getSortedPosts>>[number],
	) =>
		isEnglishPostLanguage(entry.data.lang) ||
		entry.slug.toLowerCase().startsWith("en/");
	const getEntryTranslationKey = (
		entry: Awaited<ReturnType<typeof getSortedPosts>>[number],
	) => entry.data.translationKey?.trim() || getPostTranslationKey(entry.slug);
	const getLocaleSlug = (slug: string, lang: "zh-CN" | "en") => {
		const normalizedSlug = slug.replace(/^\/+|\/+$/g, "");
		if (lang === "en") {
			return normalizedSlug.replace(/^en\//i, "");
		}
		return normalizedSlug.replace(/^zh(?:[-_](?:cn|hans))?\//i, "");
	};
	const translationMap = new Map<
		string,
		{ zhSlug?: string; enSlug?: string }
	>();

	for (const entry of allEntries) {
		const translationKey = getEntryTranslationKey(entry);
		const pair = translationMap.get(translationKey) ?? {};
		if (isEnglishEntry(entry)) {
			pair.enSlug = entry.slug;
		} else {
			pair.zhSlug = entry.slug;
		}
		translationMap.set(translationKey, pair);
	}

	return zhEntries
		.filter(
			(entry) =>
				isChinesePostLanguage(entry.data.lang) && !isEnglishEntry(entry),
		)
		.map((entry) => {
			const translationKey = getEntryTranslationKey(entry);
			const pair = translationMap.get(translationKey) ?? {};
			const zhSlug = pair.zhSlug || entry.slug;
			const enSlug = pair.enSlug || "";
			const seo: StaticPathSeo = {
				translationKey,
				canonicalPath: getPostUrlBySlugAndLang(zhSlug, "zh-CN"),
				altPathZh: getPostUrlBySlugAndLang(zhSlug, "zh-CN"),
				altPathEn: enSlug ? getPostUrlBySlugAndLang(enSlug, "en") : "",
			};

			return {
				params: { slug: getLocaleSlug(zhSlug, "zh-CN") },
				props: { entry, seo },
			};
		});
}

const { entry, seo } = Astro.props as {
	entry: Awaited<ReturnType<typeof getSortedPosts>>[number];
	seo: StaticPathSeo;
};
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();
const canonicalUrl = toAbsoluteUrl(seo.canonicalPath);
const alternateLinks = [
	{
		hrefLang: "zh-CN",
		href: toAbsoluteUrl(seo.altPathZh || seo.canonicalPath),
	},
	{ hrefLang: "en", href: toAbsoluteUrl(seo.altPathEn || seo.canonicalPath) },
	{
		hrefLang: "x-default",
		href: toAbsoluteUrl(seo.altPathZh || seo.canonicalPath),
	},
];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	...(entry.data.updated && {
		dateModified: formatDateToYYYYMMDD(entry.data.updated),
	}),
	...(entry.data.image && {
		image: new URL(entry.data.image, Astro.site).href,
	}),
	inLanguage: "zh-CN",
};
---
<MainGridLayout title={entry.data.title} description={entry.data.description} image={entry.data.image} lang="zh-CN" canonical={canonicalUrl} alternates={alternateLinks} setOGTypeArticle={true} headings={headings} hideSidebar={true}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div
            id="post-container"
            data-translation-key={seo.translationKey}
            data-alt-url-zh={seo.altPathZh}
            data-alt-url-en={seo.altPathEn}
            class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm"><span data-i18n-words={entry.slug}>{remarkPluginFrontmatter.words}</span> <span data-i18n-post="words">{t('post.words', locale)}</span></div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm"><span data-i18n-minutes={entry.slug}>{remarkPluginFrontmatter.minutes}</span> <span data-i18n-post="minutes">{t('post.minutes', locale)}</span></div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full flex items-center font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.pinned && (
                        <span class="inline-flex items-center mr-3 px-2.5 py-1 text-sm font-medium bg-[oklch(95%_0.2_var(--hue))] dark:bg-[oklch(25%_0.2_var(--hue))] text-[oklch(55%_0.2_var(--hue))] dark:text-[oklch(85%_0.2_var(--hue))] rounded">
                            <Icon name="material-symbols:push-pin" class="mr-1.5 text-base" /> 置顶
                        </span>
                    )}
                    <span>{entry.data.title}</span>
                </div>
            </div>

            <!-- description/excerpt -->
            {(entry.data.description || remarkPluginFrontmatter.excerpt) && (
                <div class="onload-animation mb-4">
                    <div class="text-black/75 dark:text-white/75 text-sm leading-relaxed">
						{entry.data.password ? "这是一篇加密文章，请输入密码后查看。" : (entry.data.description || remarkPluginFrontmatter.excerpt)}
                    </div>
                </div>
            )}

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        slug={entry.slug}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            <!-- 文章反馈与编辑区域 -->
            <div class="mb-4 p-4 rounded-lg bg-[var(--license-block-bg)] border border-[var(--line-divider)] onload-animation">
                <!-- 反馈区域 -->
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <div class="h-5 w-5 rounded bg-[var(--primary)] flex items-center justify-center">
                            <Icon name="material-symbols:help-outline" class="text-[0.75rem] text-white dark:text-black/70"></Icon>
                        </div>
                        <p class="text-black/80 dark:text-white/80 text-sm">这篇文章是否对你有帮助？</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/posts/pin/" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95">
                            <Icon name="material-symbols:contact-mail-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            联系
                        </a>
                        <a href="/donate/" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--primary)] hover:bg-[oklch(0.65_0.16_var(--hue))] active:bg-[oklch(0.60_0.18_var(--hue))] text-white dark:text-black/80 text-xs font-medium transition-all active:scale-95">
                            <Icon name="material-symbols:favorite-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            赞助
                        </a>
                    </div>
                </div>
                
                {gitHubEditConfig.enable && (
                    <>
                        <!-- 分隔线 -->
                        <div class="border-t border-[var(--line-divider)] my-3"></div>
                        
                        <!-- GitHub编辑区域 -->
                        <div class="flex items-start gap-3">
                            <div class="h-5 w-5 rounded bg-[var(--primary)] flex items-center justify-center">
                                <Icon name="material-symbols:edit-outline" class="text-[0.875rem] text-white dark:text-black/70"></Icon>
                            </div>
                            <div class="flex-1">
                                <p class="text-black/80 dark:text-white/80 text-sm mb-1">发现错误或想要改进这篇文章？</p>
                                <a 
                                    href={`${gitHubEditConfig.baseUrl}/${entry.slug}.md`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-[var(--primary)] hover:text-[oklch(0.65_0.16_var(--hue))] text-sm font-medium transition-colors"
                                >
                                    <Icon name="fa6-brands:github" class="text-[0.875rem]"></Icon>
                                    在 GitHub 上编辑此页
                                    <Icon name="material-symbols:open-in-new" class="text-[0.75rem]"></Icon>
                                </a>
                            </div>
                        </div>
                    </>
                )}
            </div>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}
            

            
            <!-- Giscus 评论区 -->
            <script src="https://giscus.app/client.js"
                    data-repo="afoim/giscus-fuwari"
                    data-repo-id="R_kgDOOi8quw"
                    data-category="Announcements"
                    data-category-id="DIC_kwDOOi8qu84CprDV"
                    data-mapping="pathname"
                    data-strict="0"
                    data-reactions-enabled="1"
                    data-emit-metadata="0"
                    data-input-position="top"
                    data-theme="noborder_gray"
                    data-lang="zh-CN"
                    data-loading="lazy"
                    crossorigin="anonymous"
                    async>
            </script>
    <br>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>
	<script>
    import CryptoJS from 'crypto-js';
    import bcrypt from 'bcryptjs';

    // 设置免密缓存的有效期（例如：24小时）
    const ENCRYPTION_EXPIRY_MS = 1000 * 60 * 60 * 24; 

    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('encrypted-post-wrapper');
        if (!wrapper) return;

        const btn = document.getElementById('post-decrypt-btn');
        const input = document.getElementById('post-password-input');
        const error = document.getElementById('post-decrypt-error');

        const hash = wrapper.dataset.hash;
        const ciphertext = wrapper.dataset.ciphertext;
        const slug = window.location.pathname;
        const storageKey = `unlocked_post_${slug}`; // 为每篇文章生成独立的缓存 Key

        // 执行解密并替换 DOM 内容的函数
        const unlockContent = (password) => {
            try {
                const bytes = CryptoJS.AES.decrypt(ciphertext, password);
                const originalHtml = bytes.toString(CryptoJS.enc.Utf8);
                
                if (!originalHtml) throw new Error("解密结果为空");

                const markdownContainer = wrapper.closest('.markdown-content');
                if (markdownContainer) {
                    // 添加平滑的淡出过渡动画
                    wrapper.style.opacity = '0';
                    wrapper.style.transition = 'opacity 0.3s ease';
                    
                    setTimeout(() => {
                        markdownContainer.innerHTML = originalHtml;
                        // 触发可能需要的代码高亮/组件重新渲染事件
                        document.dispatchEvent(new Event('content-decrypted'));
                    }, 300);
                    return true;
                }
            } catch (e) {
                console.error("解密失败:", e);
                return false;
            }
            return false;
        };

        // 1. 页面加载时：检查 localStorage 是否已有未过期的密码缓存
        const storedSession = localStorage.getItem(storageKey);
        if (storedSession) {
            try {
                const { password, timestamp } = JSON.parse(storedSession);
                // 检查是否过期
                if (Date.now() - timestamp < ENCRYPTION_EXPIRY_MS) {
                    // 快速验证缓存密码是否正确
                    if (bcrypt.compareSync(password, hash)) {
                        unlockContent(password);
                        return; // 直接解锁，不显示密码框
                    } else {
                        localStorage.removeItem(storageKey);
                    }
                } else {
                    localStorage.removeItem(storageKey); // 已过期，清理
                }
            } catch (e) {
                localStorage.removeItem(storageKey);
            }
        }

        // 2. 处理用户手动点击解锁
        const handleDecrypt = () => {
            const password = (input as HTMLInputElement).value;
            if (!password || !hash || !ciphertext) return;

            // 锁定按钮，防止重复点击导致浏览器卡死
            btn.textContent = "正在解锁...";
            btn.style.opacity = '0.7';
            btn.style.pointerEvents = 'none';
            error.classList.add('hidden');

            // ⚠️ 关键：使用 setTimeout 将重度运算放到事件循环的下一步，防止 "正在解锁..." 文本渲染不出来
            setTimeout(() => {
                if (bcrypt.compareSync(password, hash)) {
                    const success = unlockContent(password);
                    
                    if (success) {
                        // 解密成功，将密码和当前时间存入 localStorage
                        localStorage.setItem(storageKey, JSON.stringify({
                            password: password,
                            timestamp: Date.now()
                        }));
                    } else {
                        error.classList.remove('hidden');
                        error.innerText = '解密失败，数据可能已损坏。 / Decryption failed.';
                        resetBtn();
                    }
                } else {
                    error.classList.remove('hidden');
                    error.innerText = '密码错误，请重试！ / Incorrect password!';
                    resetBtn();
                }
            }, 50);
        };

        const resetBtn = () => {
            btn.textContent = "解锁 / Unlock";
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
        };

        if (btn && input) {
            btn.addEventListener('click', handleDecrypt);
            input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') handleDecrypt();
            });
        }
    });
</script>
</MainGridLayout>
